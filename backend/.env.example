# Copy to backend/.env and adjust. Every value is optional for local development.

# Defaults to a local SQLite file (sqlite:///./drawzy.db).
DATABASE_URL=mysql+pymysql://drawzy:drawzy@localhost:3306/drawzy

# Use a long random value in any shared environment: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_HOURS=4

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:3000
